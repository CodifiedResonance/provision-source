{
  "name": "provision-source-integrity",
  "private": true,
  "version": "5.0.0-staging.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && node scripts/clean.mjs && vite build && node scripts/package.mjs",
    "test": "npm run generate && node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck contract/provision-integrity-api-v1.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3"
  }
}
